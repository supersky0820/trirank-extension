{
  "manifest_version": 3,
  "name": "TriRank SEO & AEO — AI Visibility Checker",
  "short_name": "TriRank",
  "version": "1.8.0",
  "description": "See what AI engines already know about the site you're on, and test whether AI crawlers can actually reach it.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["https://trirankai.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
